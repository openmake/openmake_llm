{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bump-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "✨ 기능" },
    { "type": "fix", "section": "🐛 버그 수정" },
    { "type": "perf", "section": "⚡ 성능" },
    { "type": "refactor", "section": "♻️ 리팩터링" },
    { "type": "docs", "section": "📝 문서", "hidden": true },
    { "type": "test", "section": "✅ 테스트", "hidden": true },
    { "type": "chore", "section": "🔧 기타", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "openmake-llm",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "apps/api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/discord-bot/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/api-client/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/config/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/shared-types/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
