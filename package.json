{
    "name": "openmake",
    "version": "1.113.0",
    "description": "OpenMake - AI Assistant Platform",
    "main": "apps/api/dist/server.js",
    "scripts": {
        "build": "npm run build:packages && npm run build:backend && npm run build:frontend-next",
        "build:packages": "npm run build --workspace=@openmake/plugin-contracts && npm run build --workspace=@openmake/shared-types && npm run build --workspace=@openmake/config && npm run build --workspace=@openmake/api-client && npm run build --workspace=@openmake/local-bridge-core",
        "build:database": "echo 'No separate database build needed'",
        "build:backend": "cd apps/api && npm run build",
        "build:frontend-next": "cd apps/web && npm run build",
        "build:all": "npm run build",
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend-next\"",
        "dev:api": "cd apps/api && npm run dev",
        "dev:frontend-next": "cd apps/web && npm run dev",
        "start": "node apps/api/dist/server.js",
        "start:api": "node apps/api/dist/server.js",
        "test": "npm run build:packages && npm run test:infra && npm test --workspace=@openmake/local-bridge-core && npm test --workspace=apps/api",
        "test:db": "node scripts/ci/run-db-tests.mjs",
        "test:infra": "node --test \"infra/**/*.test.mjs\" \"scripts/lint/*.test.mjs\" \"scripts/ci/*.test.mjs\" \"scripts/bench/*.test.mjs\" \"scripts/release/*.test.mjs\" \"tests/pipeline/*.test.mjs\" \"scripts/pipeline/*.test.mjs\" \"scripts/vllm/*.test.mjs\"",
        "verify:matrix": "node scripts/release/verify-matrix.mjs",
        "release:candidate": "node scripts/release/release-candidate.mjs",
        "bench:api": "node scripts/bench/api-load.mjs",
        "bench:compare": "node scripts/bench/compare.mjs",
        "test:backend": "npm run build:packages && npm test --workspace=apps/api",
        "test:e2e": "npx playwright test",
        "test:web": "node tests/web/run-tests.mjs",
        "test:e2e:ui": "npx playwright test --ui",
        "lint": "eslint .",
        "check:addon-boundary": "node scripts/lint/check-addon-boundary.mjs",
        "gen:addon-boundary": "node scripts/lint/gen-addon-import-allowlist.mjs",
        "audit:gate": "node scripts/audit-gate.cjs",
        "contracts:export": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"bundler\"}' ts-node --transpile-only scripts/export-openapi.ts",
        "clean": "rm -rf */dist **/dist",
        "version": "node -e \"const v=require('./package.json').version;const fs=require('fs');['apps/api/package.json','apps/web/package.json'].forEach(f=>{const p=JSON.parse(fs.readFileSync(f,'utf8'));p.version=v;fs.writeFileSync(f,JSON.stringify(p,null,4)+'\\n')});console.log('✅ 모든 workspace 버전 동기화 완료:',v)\" && git add apps/api/package.json apps/web/package.json",
        "build:discord-bot": "cd apps/discord-bot && npm run build",
        "test:dev": "node scripts/ci/dev-checks.mjs",
        "test:features": "node scripts/ci/feature-checks.mjs"
    },
    "keywords": [
        "ai",
        "assistant",
        "vllm",
        "litellm",
        "llm"
    ],
    "author": "",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "apps/api",
        "apps/web",
        "apps/cli",
        "apps/discord-bot",
        "packages/*"
    ],
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/supertest": "^7.2.1",
        "autocannon": "^8.0.0",
        "concurrently": "^10.0.6",
        "esbuild": "0.28.2",
        "eslint": "^10.13.0",
        "jest": "^30.5.2",
        "playwright": "^1.58.0",
        "supertest": "^7.3.1",
        "ts-json-schema-generator": "^2.9.0",
        "typescript": "^6.0.3",
        "typescript7": "npm:typescript@^7.0.2",
        "typescript-eslint": "^8.71.2"
    },
    "overrides": {
        "js-yaml@<5": "^4.2.0",
        "adm-zip": "^0.6.1"
    }
}
