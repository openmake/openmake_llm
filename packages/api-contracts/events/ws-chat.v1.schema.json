{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openmake-ws-chat",
  "description": "WS 채팅 프로토콜 계약 — SoT: packages/shared-types (WsChatRequest 송신 / WsServerEvent 수신). 클라이언트는 미지 이벤트 type 을 무시해야 한다 (forward-compat).",
  "version": "1.0.0",
  "definitions": {
    "ArtifactMeta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "lang"
      ],
      "description": "아티팩트 메타 — 백엔드 llm/artifact-parser.ts ArtifactInfo 와 동일 계약."
    },
    "ChatRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "McpToolResource": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "description": "MCP 도구 결과의 resource content (백엔드 external-tool-exec 가 추출해 emit)."
    },
    "SearchSourceRef": {
      "type": "object",
      "properties": {
        "n": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "결과 도메인(표시용)"
        }
      },
      "required": [
        "n",
        "title",
        "url",
        "snippet"
      ],
      "description": "웹검색 구조화 출처(F19.4) — 본문 [N] 인용과 같은 번호. 서버 formatSearchSources 와 같은 순서·캡"
    },
    "WsAttachedFile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "텍스트 내용 (바이너리는 미전송). 클라이언트가 캡 초과 시 절단"
        },
        "data": {
          "type": "string",
          "description": "추출 대상 바이너리 문서(PDF/docx/xlsx/pptx 등)의 base64 원본. 백엔드가 텍스트로 추출해 content 를 채운다"
        },
        "size": {
          "type": "number"
        },
        "truncated": {
          "type": "boolean",
          "description": "전송 전 캡으로 내용을 절단했음"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "description": "첨부 텍스트 파일 (백엔드 ws-chat-handler files[] · attach-context AttachedFileInput 호환)"
    },
    "WsChatRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "message": {
          "type": "string"
        },
        "clientRequestId": {
          "type": "string",
          "description": "클라이언트 발급 멱등 키(140) — 같은 id 재전송은 새 생성 없이 이전 messageId 로 done 만 다시 온다"
        },
        "model": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "$ref": "#/definitions/ChatRole"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ]
          }
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "anonSessionId": {
          "type": "string",
          "description": "Browser-scoped anonymous owner id for guest sessions."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WsAttachedFile"
          },
          "description": "첨부 텍스트 파일 — 백엔드가 fileContext 채널로 LLM 에 주입"
        },
        "webSearch": {
          "type": "boolean"
        },
        "deepResearchMode": {
          "type": "boolean",
          "description": "구 필드(modes 도입 2026-09-19 전) — 새 클라이언트는 modes 를 쓴다. 구 클라이언트(iOS) 호환용으로 서버가 읽는다"
        },
        "discussionMode": {
          "type": "boolean",
          "description": "구 필드(modes 도입 2026-09-19 전) — 새 클라이언트는 modes 를 쓴다. 구 클라이언트(iOS) 호환용으로 서버가 읽는다"
        },
        "thinkingMode": {
          "type": "boolean",
          "description": "Sequential Thinking 모드 (UI thinkingEnabled 토글)"
        },
        "imageMode": {
          "type": "boolean",
          "description": "이미지 생성 모드 — ON 이면 메시지를 프롬프트로 이미지를 직접 생성"
        },
        "artifactMode": {
          "type": "boolean",
          "description": "아티팩트 모드 — ON 이면 모델이 <artifact> 산출물을 생성하도록 유도"
        },
        "style": {
          "type": "string",
          "enum": [
            "concise",
            "default",
            "verbose"
          ],
          "description": "응답 스타일 — 백엔드 chat/style.ts 가 system prompt 앞에 style guard 를 prepend (concise=간결, verbose=상세)"
        },
        "enabledTools": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "켜진 채팅 모드(add-on) — add-on id → true. 서버가 일반 채팅 대신 그 모드로 턴을 처리한다"
        },
        "contextRefs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ]
          },
          "description": "통합(add-on)별 외부 컨텍스트 참조 — add-on id → 참조. 컴포저의 컨텍스트 선택기가 보낸다(백엔드가 LLM 전용 채널에 접두 주입)"
        },
        "notebook": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "구 필드(contextRefs 도입 2026-09-19 전) — 새 클라이언트는 보내지 않는다. 구 클라이언트 호환용으로만 서버가 읽는다"
        },
        "saveHistory": {
          "type": "boolean",
          "description": "개인정보: false 면 백엔드가 대화 기록 저장을 생략 (설정 페이지 토글). 기본 true"
        },
        "memoryLearning": {
          "type": "boolean",
          "description": "개인정보: false 면 메모리 학습 비활성 (saveHistory 와 독립). 기본 true"
        },
        "userAgentId": {
          "type": "string",
          "description": "커스텀 에이전트(user_agents) id — 지정 시 백엔드가 산업 에이전트 자동라우팅을 우회하고 해당 페르소나 system_prompt 를 prepend"
        },
        "userLocation": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          },
          "required": [
            "lat",
            "lng"
          ],
          "description": "기기 GPS 현재 위치 (폰 기능 2단계, 옵트인) — 클라이언트가 위치 관련 턴에만 첨부. 서버는 system 컨텍스트에 결정적 주입해 카카오 search-places(x=lng, y=lat) 좌표 검색을 가능하게 한다. 저장하지 않는 턴 단위 값."
        },
        "client": {
          "type": "string",
          "const": "ios",
          "description": "클라이언트 표면 — 좁은 화면(모바일 네이티브)에 맞는 답변 형식을 요청할 때 'ios'. 미지정은 기존 동작(데스크톱 기준). 서버는 이 값으로 answer-format 에 화면 폭 지시를 덧붙일 뿐, 내용/기능 분기는 하지 않는다."
        },
        "lane": {
          "type": "string",
          "description": "비교 모드(두 모델 동시 답변) 패널 식별자. 같은 사용자의 스트림 키에 접미사로 붙어 레인별로 독립 스트림을 가진다. 형식 `^[a-z0-9_-]{1,16}$`, 그 외는 무시(레인 없음). (2026-09-09)"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "WsResumeRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resume"
        },
        "anonSessionId": {
          "type": "string",
          "description": "게스트 스트림 키"
        },
        "lane": {
          "type": "string",
          "description": "비교 모드 레인"
        },
        "streamId": {
          "type": "string",
          "description": "마지막으로 받은 이벤트의 streamId"
        },
        "afterSeq": {
          "type": "number",
          "description": "마지막으로 받은 이벤트의 seq — 같은 스트림이면 이 뒤 이벤트만 재생"
        }
      },
      "required": [
        "type"
      ],
      "description": "재연결 후 끊긴 스트림 이어받기 요청 — 커서가 없거나 다른 스트림이면 서버는 미전달 이벤트만 재생한다(종전 동작)."
    },
    "WsServerEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "token"
            },
            "token": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "thinking"
            },
            "token": {
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "thinking_summary"
            },
            "summary": {
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "summary"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "answer_verification"
            },
            "issues": {
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "issues"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_created"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "served_model"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "build_id"
            },
            "buildId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "buildId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "token_warning"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "debug_retained"
            },
            "captureId": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string"
            },
            "ttlHours": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "captureId",
            "expiresAt",
            "ttlHours"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "system_event"
            },
            "payload": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "type",
                "message"
              ]
            }
          },
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "done"
            },
            "messageId": {
              "type": "string"
            },
            "metrics": {
              "type": "object",
              "properties": {
                "tokensPerSec": {
                  "type": "string"
                },
                "tokenCount": {
                  "type": "number"
                }
              },
              "required": [
                "tokensPerSec",
                "tokenCount"
              ],
              "description": "백엔드 실제 페이로드(ws-chat-handler): 스트리밍 완료 시 토큰 메트릭. tokensPerSec 는 toFixed(2) 문자열."
            },
            "cleanedContent": {
              "type": "string",
              "description": "아티팩트가 있으면 raw 코드펜스가 placeholder 로 치환된 본문 — 클라가 누적 본문을 이걸로 reset."
            },
            "deduplicated": {
              "type": "boolean",
              "description": "같은 clientRequestId 의 재전송이라 새 생성 없이 끝냈음(140)"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aborted"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stream_resume"
            },
            "messageId": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "thinking": {
              "type": "string"
            },
            "finished": {
              "type": "boolean"
            },
            "streamId": {
              "type": "string",
              "description": "이 스트림의 식별자(F19.11) — 클라이언트 커서가 다르면 새 스트림으로 본다"
            },
            "lastSeq": {
              "type": "number",
              "description": "스냅샷이 반영한 마지막 순번"
            },
            "gap": {
              "type": "boolean",
              "description": "재생해야 할 이벤트 일부가 링버퍼에서 밀려났음 — 아티팩트는 done.cleanedContent 로 재구성할 것"
            },
            "servedModel": {
              "type": "string",
              "description": "마지막으로 발행한 served_model 값 — 링에서 밀려났어도 답하는 모델을 알 수 있게 스냅샷에 싣는다"
            }
          },
          "required": [
            "type",
            "content",
            "finished"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resume_none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "search_sources"
            },
            "messageId": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SearchSourceRef"
              }
            }
          },
          "required": [
            "type",
            "sources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "error"
            },
            "message": {
              "type": "string"
            },
            "errorType": {
              "type": "string",
              "description": "에러 분류(quota_exceeded / api_keys_exhausted / provider code 등)"
            },
            "retryAfter": {
              "type": "number",
              "description": "재시도 가능까지 남은 초(quota/키 소진)."
            },
            "resetTime": {
              "type": "string",
              "description": "키 쿨다운 해제 시각(ISO) — api_keys_exhausted."
            },
            "totalKeys": {
              "type": "number"
            },
            "keysInCooldown": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "init"
            },
            "data": {}
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent_selected"
            },
            "agent": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "nameEn": {
                  "type": "string",
                  "description": "영어 표시 이름 — 한국어 외 UI 는 이것을 쓴다(산업·범용 에이전트만, 커스텀 에이전트는 없음)"
                },
                "emoji": {
                  "type": "string"
                },
                "phase": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "name"
              ]
            }
          },
          "required": [
            "type",
            "agent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "skills_activated"
            },
            "skillNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skillNamesEn": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "시스템 시드 스킬의 영어 표시 이름(스킬 이름 → 영어) — 사용자·확장 스킬은 없다"
            }
          },
          "required": [
            "type",
            "skillNames"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mcp_tool_start"
            },
            "toolName": {
