  "clickPointJs": [
    {"id":"plain","input":{"sel":"\"#login\""},"expect":"(() => {\n                    const el = document.querySelector(\"#login\");\n                    if (!el) return null;\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    const r = el.getBoundingClientRect();\n                    return r.width === 0 && r.height === 0 ? null : { x: r.left + r.width / 2, y: r.top + r.height / 2 };\n                })()"},
    {"id":"quote","input":{"sel":"\"a[title=\\\"x\\\"]\""},"expect":"(() => {\n                    const el = document.querySelector(\"a[title=\\\"x\\\"]\");\n                    if (!el) return null;\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    const r = el.getBoundingClientRect();\n                    return r.width === 0 && r.height === 0 ? null : { x: r.left + r.width / 2, y: r.top + r.height / 2 };\n                })()"},
    {"id":"tricky","input":{"sel":"\"</script>\u2028\\\\\""},"expect":"(() => {\n                    const el = document.querySelector(\"</script>\u2028\\\\\");\n                    if (!el) return null;\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    const r = el.getBoundingClientRect();\n                    return r.width === 0 && r.height === 0 ? null : { x: r.left + r.width / 2, y: r.top + r.height / 2 };\n                })()"}
  ],
  "fillPrepareJs": [
    {"id":"plain","input":{"sel":"\"#login\""},"expect":"(() => {\n                    const el = document.querySelector(\"#login\");\n                    if (!el) return null;\n                    const editable = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable;\n                    if (!editable) return 'not-editable';\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    el.focus();\n                    if (typeof el.select === 'function') el.select(); else getSelection().selectAllChildren(el);\n                    return 'ok';\n                })()"},
    {"id":"quote","input":{"sel":"\"a[title=\\\"x\\\"]\""},"expect":"(() => {\n                    const el = document.querySelector(\"a[title=\\\"x\\\"]\");\n                    if (!el) return null;\n                    const editable = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable;\n                    if (!editable) return 'not-editable';\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    el.focus();\n                    if (typeof el.select === 'function') el.select(); else getSelection().selectAllChildren(el);\n                    return 'ok';\n                })()"},
    {"id":"tricky","input":{"sel":"\"</script>\u2028\\\\\""},"expect":"(() => {\n                    const el = document.querySelector(\"</script>\u2028\\\\\");\n                    if (!el) return null;\n                    const editable = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable;\n                    if (!editable) return 'not-editable';\n                    el.scrollIntoView({ block: 'center', inline: 'center' });\n                    el.focus();\n                    if (typeof el.select === 'function') el.select(); else getSelection().selectAllChildren(el);\n                    return 'ok';\n                })()"}
