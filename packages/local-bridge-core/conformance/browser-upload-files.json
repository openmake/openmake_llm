{
  "suite": "browser-upload-files",
  "version": 1,
  "baseSetup": [{"dir":"base/docs"},{"file":"base/docs/a.pdf","content":"pdf"},{"file":"base/b.png","content":"png"},{"file":"base/.env","content":"SECRET=1"},{"file":"base/.git/config","content":"x"},{"file":"outside/secret.txt","content":"secret"}],
  "cases": [
    {"id":"ts-ok","setup":[],"input":{"base":"{{TMP}}/base","files":["docs/a.pdf","b.png"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf","{{TMP}}/base/b.png"]}},
    {"id":"ts-parent","setup":[],"input":{"base":"{{TMP}}/base","files":["../x.txt"]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: ../x.txt"}},
    {"id":"ts-absolute","setup":[],"input":{"base":"{{TMP}}/base","files":["/work/omk-abs-secret.txt"]},"expect":{"error":"폴더 기준 상대 경로만 올릴 수 있습니다: /work/omk-abs-secret.txt"}},
    {"id":"ts-link-outside","setup":[{"symlink":"base/link.txt","target":"{{TMP}}/outside/secret.txt"}],"input":{"base":"{{TMP}}/base","files":["link.txt"]},"expect":{"error":"심링크 스코프 탈출 거부: link.txt"}},
    {"id":"ts-hidden-file","setup":[],"input":{"base":"{{TMP}}/base","files":[".env"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: .env"}},
    {"id":"ts-hidden-dir","setup":[],"input":{"base":"{{TMP}}/base","files":[".git/config"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: .git/config"}},
    {"id":"ts-link-to-hidden","setup":[{"symlink":"base/env-link.txt","target":"{{TMP}}/base/.env"}],"input":{"base":"{{TMP}}/base","files":["env-link.txt"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: env-link.txt"}},
    {"id":"ts-too-big","setup":[{"file":"base/big.bin","size":8388609}],"input":{"base":"{{TMP}}/base","files":["big.bin"]},"expect":{"error":"파일이 너무 큽니다(8388609b > 8388608b): big.bin"}},
    {"id":"ts-missing","setup":[],"input":{"base":"{{TMP}}/base","files":["nope.txt"]},"expect":{"error":"파일이 없습니다: nope.txt"}},
    {"id":"ts-folder","setup":[],"input":{"base":"{{TMP}}/base","files":["docs"]},"expect":{"error":"파일이 아닙니다: docs"}},
    {"id":"ts-empty-list","setup":[],"input":{"base":"{{TMP}}/base","files":[]},"expect":{"error":"uploadFile 액션에는 files(폴더 기준 상대 경로 배열)가 필요합니다"}},
    {"id":"ts-not-string","setup":[],"input":{"base":"{{TMP}}/base","files":[3]},"expect":{"error":"업로드할 파일 이름이 비어 있습니다"}},
    {"id":"ts-empty-name","setup":[],"input":{"base":"{{TMP}}/base","files":[""]},"expect":{"error":"업로드할 파일 이름이 비어 있습니다"}},
    {"id":"ts-not-array","setup":[],"input":{"base":"{{TMP}}/base","files":"b.png"},"expect":{"error":"uploadFile 액션에는 files(폴더 기준 상대 경로 배열)가 필요합니다"}},
    {"id":"ts-too-many","setup":[],"input":{"base":"{{TMP}}/base","files":["b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png"]},"expect":{"error":"한 번에 올릴 수 있는 파일은 10개까지입니다(11개)"}},
    {"id":"ten-files","setup":[],"input":{"base":"{{TMP}}/base","files":["b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png","b.png"]},"expect":{"paths":["{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png","{{TMP}}/base/b.png"]}},
    {"id":"size-at-limit","setup":[{"file":"base/edge.bin","size":8388608}],"input":{"base":"{{TMP}}/base","files":["edge.bin"]},"expect":{"paths":["{{TMP}}/base/edge.bin"]}},
    {"id":"double-slash","setup":[],"input":{"base":"{{TMP}}/base","files":["docs//a.pdf"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf"]}},
    {"id":"dot-segments","setup":[],"input":{"base":"{{TMP}}/base","files":["./b.png","docs/./a.pdf"]},"expect":{"paths":["{{TMP}}/base/b.png","{{TMP}}/base/docs/a.pdf"]}},
    {"id":"trailing-slash-dir","setup":[],"input":{"base":"{{TMP}}/base","files":["docs/"]},"expect":{"error":"파일이 아닙니다: docs/"}},
    {"id":"trailing-slash-file","setup":[],"input":{"base":"{{TMP}}/base","files":["b.png/"]},"expect":{"paths":["{{TMP}}/base/b.png"]}},
    {"id":"backslash-separator","setup":[],"input":{"base":"{{TMP}}/base","files":["docs\\a.pdf"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf"]}},
    {"id":"drive-letter","setup":[],"input":{"base":"{{TMP}}/base","files":["C:x"]},"expect":{"error":"폴더 기준 상대 경로만 올릴 수 있습니다: C:x"}},
    {"id":"drive-lower-slash","setup":[],"input":{"base":"{{TMP}}/base","files":["c:/x"]},"expect":{"error":"폴더 기준 상대 경로만 올릴 수 있습니다: c:/x"}},
    {"id":"backslash-root","setup":[],"input":{"base":"{{TMP}}/base","files":["\\x"]},"expect":{"error":"폴더 기준 상대 경로만 올릴 수 있습니다: \\x"}},
    {"id":"unc","setup":[],"input":{"base":"{{TMP}}/base","files":["\\\\server\\share\\x"]},"expect":{"error":"폴더 기준 상대 경로만 올릴 수 있습니다: \\\\server\\share\\x"}},
    {"id":"blank-name","setup":[],"input":{"base":"{{TMP}}/base","files":["   "]},"expect":{"error":"업로드할 파일 이름이 비어 있습니다"}},
    {"id":"null-item","setup":[],"input":{"base":"{{TMP}}/base","files":[null]},"expect":{"error":"업로드할 파일 이름이 비어 있습니다"}},
    {"id":"object-item","setup":[],"input":{"base":"{{TMP}}/base","files":[{"p":"b.png"}]},"expect":{"error":"업로드할 파일 이름이 비어 있습니다"}},
    {"id":"space-prefix","setup":[],"input":{"base":"{{TMP}}/base","files":[" b.png"]},"expect":{"error":"파일이 없습니다:  b.png"}},
    {"id":"hidden-inner","setup":[{"file":"base/sub/.hidden/x","content":"x"}],"input":{"base":"{{TMP}}/base","files":["sub/.hidden/x"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: sub/.hidden/x"}},
    {"id":"dots-name","setup":[],"input":{"base":"{{TMP}}/base","files":["..."]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: ..."}},
    {"id":"parent-middle","setup":[],"input":{"base":"{{TMP}}/base","files":["docs/../b.png"]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: docs/../b.png"}},
    {"id":"parent-only","setup":[],"input":{"base":"{{TMP}}/base","files":[".."]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: .."}},
    {"id":"dot-only","setup":[],"input":{"base":"{{TMP}}/base","files":["."]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: ."}},
    {"id":"link-inside","setup":[{"symlink":"base/link-in.txt","target":"{{TMP}}/base/docs/a.pdf"}],"input":{"base":"{{TMP}}/base","files":["link-in.txt"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf"]}},
    {"id":"link-relative-inside","setup":[{"symlink":"base/rel-in.txt","target":"docs/a.pdf"}],"input":{"base":"{{TMP}}/base","files":["rel-in.txt"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf"]}},
    {"id":"link-dangling","setup":[{"symlink":"base/dead.txt","target":"{{TMP}}/base/none.txt"}],"input":{"base":"{{TMP}}/base","files":["dead.txt"]},"expect":{"error":"ENOENT: no such file or directory, realpath '{{TMP}}/base/dead.txt'"}},
    {"id":"link-dir-inside","setup":[{"symlink":"base/docs-link","target":"{{TMP}}/base/docs"}],"input":{"base":"{{TMP}}/base","files":["docs-link/a.pdf"]},"expect":{"paths":["{{TMP}}/base/docs/a.pdf"]}},
    {"id":"link-dir-hidden","setup":[{"symlink":"base/gitlink","target":"{{TMP}}/base/.git"}],"input":{"base":"{{TMP}}/base","files":["gitlink/config"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: gitlink/config"}},
    {"id":"link-dir-outside","setup":[{"symlink":"base/outlink","target":"{{TMP}}/outside"}],"input":{"base":"{{TMP}}/base","files":["outlink/secret.txt"]},"expect":{"error":"심링크 스코프 탈출 거부: outlink/secret.txt"}},
    {"id":"link-dir-outside-backslash","setup":[{"symlink":"base/outlink","target":"{{TMP}}/outside"}],"input":{"base":"{{TMP}}/base","files":["outlink\\secret.txt"]},"expect":{"error":"심링크 스코프 탈출 거부: outlink/secret.txt"}},
    {"id":"link-to-base","setup":[{"symlink":"base/self","target":"{{TMP}}/base"}],"input":{"base":"{{TMP}}/base","files":["self"]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: self"}},
    {"id":"first-error-wins","setup":[],"input":{"base":"{{TMP}}/base","files":["b.png","../x",".env"]},"expect":{"error":"폴더 밖 파일은 올릴 수 없습니다: ../x"}},
    {"id":"count-before-items","setup":[],"input":{"base":"{{TMP}}/base","files":["","","","","","","","","","",""]},"expect":{"error":"한 번에 올릴 수 있는 파일은 10개까지입니다(11개)"}},
    {"id":"hangul-name","setup":[{"file":"base/문서.txt","content":"k"}],"input":{"base":"{{TMP}}/base","files":["문서.txt"]},"expect":{"paths":["{{TMP}}/base/문서.txt"]}},
    {"id":"emoji-dir","setup":[{"file":"base/😀/a.txt","content":"e"}],"input":{"base":"{{TMP}}/base","files":["😀/a.txt"]},"expect":{"paths":["{{TMP}}/base/😀/a.txt"]}},
    {"id":"upper-hidden","setup":[{"file":"base/.Hidden","content":"h"}],"input":{"base":"{{TMP}}/base","files":[".Hidden"]},"expect":{"error":"숨김 파일은 올릴 수 없습니다: .Hidden"}},
    {"id":"base-via-link","setup":[{"symlink":"baselink","target":"{{TMP}}/base"}],"input":{"base":"{{TMP}}/baselink","files":["b.png"]},"expect":{"paths":["{{TMP}}/base/b.png"]}},
    {"id":"base-missing","setup":[],"input":{"base":"{{TMP}}/nope","files":["b.png"]},"expect":{"error":"ENOENT: no such file or directory, realpath '{{TMP}}/nope'"}},
    {"id":"base-missing-empty-list","setup":[],"input":{"base":"{{TMP}}/nope","files":[]},"expect":{"error":"uploadFile 액션에는 files(폴더 기준 상대 경로 배열)가 필요합니다"}}
  ]
}
