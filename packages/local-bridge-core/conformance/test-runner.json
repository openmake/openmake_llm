    {
      "id": "pytest-ini",
      "setup": [
        {"file":"d/pytest.ini","content":""},
        {"fakeTool":"bin/python3","stdout":"","stderr":"","exit":0,"record":"python3"}
      ],
      "input": {"dir":"{{TMP}}/d","execPath":"{{BIN}}"},
      "expect": "pytest",
      "toolCalls": [
        {"tool":"python3","args":["-I","-c","import importlib.util,site,sys; sys.path.append(site.getusersitepackages()); sys.exit(0 if importlib.util.find_spec('pytest') else 1)"],"cwd":"{{TMP}}/d","envHas":["PATH","HOME"],"envLacks":["OMK_COMPANION_API_KEY","GITHUB_TOKEN","OMK_BRIDGE_AUTO_APPROVE"]}
      ]
