{
  "suite": "test-runner",
  "version": 1,
  "cases": [
    {
      "id": "empty",
      "setup": [
        {"dir":"root"}
      ],
      "root": "root",
      "requests": [
        {"msg":{"kind":"test_runner"},"expect":{"ok":true,"testRunner":"none"}},
        {"msg":{"kind":"test_runner","path":"."},"expect":{"ok":true,"testRunner":"none"}},
        {"msg":{"kind":"test_runner","path":"nope"},"expect":{"ok":true,"testRunner":"none"}},
        {"msg":{"kind":"test_runner","path":""},"expect":{"ok":true,"testRunner":"none"}}
      ]
    },
    {
      "id": "npm",
      "setup": [
        {"file":"root/package.json","content":"{\"scripts\":{\"test\":\"jest\"}}"},
        {"dir":"root/node_modules"},
        {"file":"root/sub/package.json","content":"{\"scripts\":{\"test\":\"node t.js\"}}"}
      ],
      "root": "root",
      "requests": [
        {"msg":{"kind":"test_runner"},"expect":{"ok":true,"testRunner":"npm"}},
        {"msg":{"kind":"test_runner","path":"sub"},"expect":{"ok":true,"testRunner":"npm"}},
        {"msg":{"kind":"test_runner","path":"sub/package.json"},"expect":{"ok":true,"testRunner":"none"}}
      ]
    },
    {
      "id": "scope",
      "setup": [
        {"dir":"root"}
      ],
      "root": "root",
      "requests": [
        {"msg":{"kind":"test_runner","path":"../x"},"expect":{"ok":false,"error":"폴더 스코프 밖 경로 거부: ../x"}},
        {"msg":{"kind":"test_runner","folder":"../x"},"expect":{"ok":false,"error":"폴더 스코프 밖 경로 거부: ../x"}},
        {"msg":{"kind":"test_runner","folder":"nope"},"expect":{"ok":false,"error":"실행 폴더가 존재하지 않습니다: nope"}}
      ]
    }
  ],
  "direct": [
    {
      "id": "npm-node-no-modules",
      "setup": [
        {"file":"d/package.json","content":"{\"scripts\":{\"test\":\"node x.js\"}}"}
      ],
      "input": {"dir":"{{TMP}}/d","execPath":"{{BIN}}"},
      "expect": "npm"
    },
