        {"dir":"repo"},
        {"git":["init","-q"],"cwd":"repo"},
        {"file":"repo/a.txt","content":"base\n"},
        {"git":["add","."],"cwd":"repo"},
        {"git":["commit","-q","-m","base"],"cwd":"repo"}
      ],
      "root": "repo",
      "steps": [
        {"msg":{"kind":"worktree","op":"add","taskId":"wtadd001-root"},"expect":{"ok":true,"worktreeRel":".openmake/worktrees/wtadd001-root","branch":"omk-task/wtadd001"},"after":[{"exists":"repo/.openmake/worktrees/wtadd001-root/a.txt","content":"base\n"},{"fileHas":"repo/.git/info/exclude","line":".openmake/","count":1}]},
