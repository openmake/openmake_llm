{
  "suite": "home-read",
  "version": 1,
  "guard": [
    {"id": "under-home", "input": {"home": "/h", "path": "/h/dot/mise"}, "expect": true},
    {"id": "home-itself", "input": {"home": "/h", "path": "/h"}, "expect": false},
    {"id": "outside-home", "input": {"home": "/h", "path": "/opt/mise"}, "expect": false},
    {"id": "home-ancestor", "input": {"home": "/h", "path": "/"}, "expect": false},
    {"id": "privacy-item", "input": {"home": "/h", "path": "/h/Documents"}, "expect": false},
    {"id": "inside-privacy", "input": {"home": "/h", "path": "/h/Documents/dot/mise"}, "expect": false},
    {"id": "privacy-ancestor", "input": {"home": "/h", "path": "/h/Library"}, "expect": false},
    {"id": "privacy-sibling-prefix", "input": {"home": "/h", "path": "/h/Documents2"}, "expect": true},
    {"id": "library-other", "input": {"home": "/h", "path": "/h/Library/Application Support/fnm2"}, "expect": true},
    {"id": "top-under-home", "input": {"home": "/h", "path": "/h/work/repo", "top": true}, "expect": true},
    {"id": "top-outside-home", "input": {"home": "/h", "path": "/work/repo", "top": true}, "expect": true},
    {"id": "top-home", "input": {"home": "/h", "path": "/h", "top": true}, "expect": false},
    {"id": "top-home-ancestor", "input": {"home": "/h", "path": "/", "top": true}, "expect": false},
    {"id": "top-privacy-item", "input": {"home": "/h", "path": "/h/Documents", "top": true}, "expect": false},
    {"id": "top-privacy-ancestor", "input": {"home": "/h", "path": "/h/Library", "top": true}, "expect": false},
    {"id": "top-inside-privacy", "input": {"home": "/h", "path": "/h/Documents/repo", "top": true}, "expect": true}
  ],
  "gitConfig": [
    {"id": "basic", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n~/.gitconfig.local\u0000file:/h/.gitconfig.local\u0000user.name\nX\u0000file:/h/.gitconfig\u0000core.excludesfile\n~/.gitignore_global\u0000"}, "expect": ["/h/.gitconfig", "/h/.gitconfig.local", "/h/.gitignore_global"]},
    {"id": "value-less-key", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000core.bare\u0000"}, "expect": ["/h/.gitconfig"]},
    {"id": "includeif", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000includeif.gitdir:~/work/.path\n~/work/.gitconfig\u0000"}, "expect": ["/h/.gitconfig", "/h/work/.gitconfig"]},
    {"id": "relative-include", "input": {"home": "/h", "out": "file:/h/dot/gitconfig\u0000include.path\nlocal.inc\u0000file:/h/dot/gitconfig\u0000include.path\n../shared/x.inc\u0000"}, "expect": ["/h/dot/gitconfig", "/h/dot/local.inc", "/h/shared/x.inc"]},
    {"id": "relative-origin", "input": {"home": "/h", "out": "file:.git/config\u0000include.path\n~/x\u0000file:.git/config\u0000include.path\ny\u0000"}, "expect": ["/h/x"]},
    {"id": "excludes-relative-dropped", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000core.excludesfile\nignore\u0000file:/h/.gitconfig\u0000core.attributesfile\n/etc/attrs\u0000"}, "expect": ["/h/.gitconfig", "/etc/attrs"]},
    {"id": "value-with-newline", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n~/a\nb\u0000"}, "expect": ["/h/.gitconfig", "/h/a\nb"]},
    {"id": "odd-tokens", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n~/a\u0000file:/h/b"}, "expect": ["/h/.gitconfig", "/h/a"]},
    {"id": "non-file-origin", "input": {"home": "/h", "out": "command line:\u0000include.path\n~/c\u0000"}, "expect": ["/h/c"]},
    {"id": "tilde-user-dropped", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n~other/x\u0000file:/h/.gitconfig\u0000include.path\n~\u0000"}, "expect": ["/h/.gitconfig"]},
    {"id": "empty-value-and-other-keys", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n\u0000file:/h/.gitconfig\u0000diff.orderfile\n~/order\u0000file:/h/.gitconfig\u0000core.hookspath\n~/hooks\u0000"}, "expect": ["/h/.gitconfig"]},
    {"id": "normalize", "input": {"home": "/h", "out": "file:/h/./dot//gitconfig\u0000include.path\n~/a/../b\u0000"}, "expect": ["/h/dot/gitconfig", "/h/b"]},
    {"id": "empty-output", "input": {"home": "/h", "out": ""}, "expect": []},
    {"id": "cap", "input": {"home": "/h", "out": "file:/h/.gitconfig\u0000include.path\n~/inc00\u0000file:/h/.gitconfig\u0000include.path\n~/inc01\u0000file:/h/.gitconfig\u0000include.path\n~/inc02\u0000file:/h/.gitconfig\u0000include.path\n~/inc03\u0000file:/h/.gitconfig\u0000include.path\n~/inc04\u0000file:/h/.gitconfig\u0000include.path\n~/inc05\u0000file:/h/.gitconfig\u0000include.path\n~/inc06\u0000file:/h/.gitconfig\u0000include.path\n~/inc07\u0000file:/h/.gitconfig\u0000include.path\n~/inc08\u0000file:/h/.gitconfig\u0000include.path\n~/inc09\u0000file:/h/.gitconfig\u0000include.path\n~/inc10\u0000file:/h/.gitconfig\u0000include.path\n~/inc11\u0000file:/h/.gitconfig\u0000include.path\n~/inc12\u0000file:/h/.gitconfig\u0000include.path\n~/inc13\u0000file:/h/.gitconfig\u0000include.path\n~/inc14\u0000file:/h/.gitconfig\u0000include.path\n~/inc15\u0000file:/h/.gitconfig\u0000include.path\n~/inc16\u0000file:/h/.gitconfig\u0000include.path\n~/inc17\u0000file:/h/.gitconfig\u0000include.path\n~/inc18\u0000file:/h/.gitconfig\u0000include.path\n~/inc19\u0000file:/h/.gitconfig\u0000include.path\n~/inc20\u0000file:/h/.gitconfig\u0000include.path\n~/inc21\u0000file:/h/.gitconfig\u0000include.path\n~/inc22\u0000file:/h/.gitconfig\u0000include.path\n~/inc23\u0000file:/h/.gitconfig\u0000include.path\n~/inc24\u0000file:/h/.gitconfig\u0000include.path\n~/inc25\u0000file:/h/.gitconfig\u0000include.path\n~/inc26\u0000file:/h/.gitconfig\u0000include.path\n~/inc27\u0000file:/h/.gitconfig\u0000include.path\n~/inc28\u0000file:/h/.gitconfig\u0000include.path\n~/inc29\u0000file:/h/.gitconfig\u0000include.path\n~/inc30\u0000file:/h/.gitconfig\u0000include.path\n~/inc31\u0000file:/h/.gitconfig\u0000include.path\n~/inc32\u0000file:/h/.gitconfig\u0000include.path\n~/inc33\u0000file:/h/.gitconfig\u0000include.path\n~/inc34\u0000file:/h/.gitconfig\u0000include.path\n~/inc35\u0000file:/h/.gitconfig\u0000include.path\n~/inc36\u0000file:/h/.gitconfig\u0000include.path\n~/inc37\u0000file:/h/.gitconfig\u0000include.path\n~/inc38\u0000file:/h/.gitconfig\u0000include.path\n~/inc39\u0000"}, "expect": ["/h/.gitconfig", "/h/inc00", "/h/inc01", "/h/inc02", "/h/inc03", "/h/inc04", "/h/inc05", "/h/inc06", "/h/inc07", "/h/inc08", "/h/inc09", "/h/inc10", "/h/inc11", "/h/inc12", "/h/inc13", "/h/inc14", "/h/inc15", "/h/inc16", "/h/inc17", "/h/inc18", "/h/inc19", "/h/inc20", "/h/inc21", "/h/inc22", "/h/inc23", "/h/inc24", "/h/inc25", "/h/inc26", "/h/inc27", "/h/inc28", "/h/inc29", "/h/inc30"]}
  ],
  "envDirs": [
    {"id": "none", "input": {"env": {}}, "expect": []},
    {"id": "xdg-and-mise", "input": {"env": {"XDG_CONFIG_HOME": "/h/cfg", "XDG_DATA_HOME": "/h/data/", "MISE_DATA_DIR": "/h/m/data", "MISE_GLOBAL_CONFIG_FILE": "/h/m/config.toml", "ZDOTDIR": "/h/zsh", "MISE_GITHUB_TOKEN": "/h/secret", "HOME": "/h"}}, "expect": ["/h/cfg/mise", "/h/data/mise", "/h/m/data", "/h/m/config.toml"]},
    {"id": "shared-install-dirs", "input": {"env": {"MISE_SHARED_INSTALL_DIRS": "/h/a::rel:/h/b"}}, "expect": ["/h/a", "/h/b"]},
    {"id": "relative-dropped", "input": {"env": {"XDG_CACHE_HOME": "cache", "MISE_CACHE_DIR": "", "MISE_STATE_DIR": "./s"}}, "expect": []}
