      "id": "file-size-guard",
      "title": "apps/api/src 600줄 상한(CI Gate 3 과 같은 대상)",
      "group": "static",
      "cmd": "find apps/api/src -name '*.ts' -not -path '*/dist/*' -not -path '*__tests__*' -not -name '*.test.*' -not -name '*.d.ts' -not -name '*-locales.ts' -not -name '*-data-*.ts' -not -name '*-guidelines.ts' -not -name 'types.ts' -not -name 'runtime-limits.ts' -not -name 'prompt-templates.ts' -not -name 'language-policy.ts' -exec grep -c '' {} + | awk -F: '$2 > 600 {print; bad=1} END {exit bad}'",
      "timeoutSec": 300,
      "requiresEnv": [],
      "skipLocal": null,
      "counts": null,
      "covers": []
