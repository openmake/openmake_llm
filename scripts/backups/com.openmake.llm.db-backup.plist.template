<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenMake LLM — 일일 DB 백업 launchd 템플릿 (macOS)

  이 파일은 템플릿이다. 설치는 운영자가 판단해서 직접 한다 — 이 레포/스크립트는
  launchd 에 등록하지 않는다.

  설치 방법:
    1) 아래 자리표시자를 치환한 사본을 만든다 (예: sed 사용):
         sed \
           -e "s#{{REPO_ROOT}}#/절대/경로/openmake_llm#g" \
           -e "s#{{LOG_DIR}}#/절대/경로/openmake_llm/backups#g" \
           -e "s#{{HOUR}}#3#g" -e "s#{{MINUTE}}#30#g" \
           scripts/backups/com.openmake.llm.db-backup.plist.template \
           > ~/Library/LaunchAgents/com.openmake.llm.db-backup.plist
    2) launchctl load ~/Library/LaunchAgents/com.openmake.llm.db-backup.plist
    3) 확인: launchctl list | grep com.openmake.llm.db-backup
    4) 해제: launchctl unload ~/Library/LaunchAgents/com.openmake.llm.db-backup.plist

  주의:
    - PATH 에 docker 가 있어야 한다 — GUI 로그인 launchd 는 셸 프로파일을 읽지 않으므로
      Docker Desktop CLI 경로(보통 /usr/local/bin 또는 /opt/homebrew/bin)를 EnvironmentVariables 에
      명시했다. 실제 설치 경로가 다르면 함께 수정할 것.
    - StandardOutPath/StandardErrorPath 디렉터리는 미리 만들어져 있어야 한다({{LOG_DIR}}).
    - BACKUP_DIR/BACKUP_RETENTION_DAYS 를 .env 로 관리한다면 이 plist 의 EnvironmentVariables 에
      중복 지정할 필요 없음 — db-backup.sh 가 REPO_ROOT/.env 를 읽는다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openmake.llm.db-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{REPO_ROOT}}/scripts/backups/db-backup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 매일 {{HOUR}}:{{MINUTE}} (로컬 시간) 1회 실행 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{HOUR}}</integer>
        <key>Minute</key>
        <integer>{{MINUTE}}</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/db-backup.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/db-backup.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
