# ==============================================================================
# OpenMake LLM — 운영 기능 프로필 (install_mac.sh / install_linux.sh 가 .env 에 덧붙인다)
# ==============================================================================
# 기능 플래그 대부분은 코드에서 `process.env.X === 'true'` 라 값이 없으면 꺼진다.
# gen-env.mjs 는 부팅 필수 키만 만들므로, 운영과 같은 기능 구성이 되려면 이 값들이 필요하다.
#
# 규칙:
#   - 비밀값·호스트별 주소·경로는 넣지 않는다 (인스톨러가 설치 답변으로 채운다).
#   - 인스톨러는 .env 에 없는 키만 덧붙인다 — 사용자가 고친 값은 덮어쓰지 않는다.
#   - 실험·분석용 값(TAIL_*, OMK_GV_SKIP_THRESHOLD 등)과 운영 전용 도구(open-design)는 제외.
# ==============================================================================

# ── 서버 기본 ──
NODE_ENV=production
SERVER_HOST=0.0.0.0
LOG_LEVEL=info
STORAGE_BACKEND=redis
WS_MAX_CONNECTIONS_PER_USER=12
WS_STREAM_DETACH_GRACE_MS=600000
RL_API_KEY_MGMT_READ=200
TOOL_HEALTH_CIRCUIT_ENABLED=true

# ── 응답 언어 ──
ENABLE_DYNAMIC_RESPONSE_LANGUAGE=true
DEFAULT_RESPONSE_LANGUAGE=ko
LANGUAGE_DETECTION_MIN_CONFIDENCE=0.7
LANGUAGE_FALLBACK_LANGUAGE=en

# ── LLM ──
LLM_GATEWAY_PROVIDERS=openrouter,ollama-cloud,nvidia,hasa,bai,orcarouter,logfare
LLM_TIMEOUT=120000
LLM_FAST_FAIL_TIMEOUT_MS=30000
LLM_FAST_FAIL_PREFILL_MS_PER_1K_TOKENS=4000
LLM_WARMUP_TIMEOUT_MS=10000
LLM_MODEL_PROBE_INTERVAL_MS=300000
LLM_HOURLY_TOKEN_LIMIT=1000000000
LLM_WEEKLY_TOKEN_LIMIT=10000000000
LLM_ENABLE_REASONING_EFFORT=true
LLM_DISABLE_THINKING_BY_DEFAULT=true
LLM_REASONING_EFFORTS_JSON={"qwen3.8":["low","medium","xhigh"],"bai:glm-5.3":["low","high"]}
EXTERNAL_PROVIDER_TIMEOUT_MULTIPLIER=6
USER_MODEL_ROLES_ENABLED=true
TOKEN_COST_OUTPUT_RATIO=0.25
TOKEN_COST_USD_KRW=1400

# ── 채팅·오케스트레이션 ──
ORCHESTRATION_AUTO_DISPATCH=true
CHAT_SUBAGENT_ENABLED=true
CHAT_USER_MCP_TOOL_CAP=20
AGENT_SPAWN_ENABLED=true
AGENT_SPAWN_MAX_PARALLEL=4
SKILL_AUTO_SELECT_ENABLED=true
REPORT_PIPELINE_ENABLED=true
CAPABILITY_JOB_POLLER_ENABLED=true
CAPABILITY_VIDEO_DOWNLOAD_TIMEOUT_MS=600000
OMK_AGENT_KEYWORD_PRECLASSIFY_CONFIDENCE=0.35
OMK_COOP_ENABLED=true

# ── 메모리 ──
USER_MEMORY_AUTO_EXTRACT=true
USER_MEMORY_LLM_EXTRACT=true

# ── 에이전트 작업 ──
AGENT_TASK_DISCUSSION=true
AGENT_TASK_QUEUE_ENABLED=true
AGENT_TASK_SCHEDULES_ENABLED=true
AGENT_TASK_SUBAGENT_ENABLED=true
AGENT_TASK_LEARNING_ENABLED=true
AGENT_TASK_PROCEDURAL_SKILLS=true
AGENT_TASK_DYNAMIC_TOOLS=true
AGENT_TASK_DYNAMIC_TOOLS_MODE=embedding
AGENT_TASK_VERIFY_MODE=run
AGENT_TASK_MIDTURN_CHECKPOINT=true

# ── 샌드박스 (인스톨러가 런타임 이미지를 빌드한다 — --no-sandbox-images 면 인스톨러가 끈다) ──
MCP_SANDBOX_ENABLED=true
MCP_SANDBOX_READONLY=true
ARTIFACT_EXEC_ENABLED=true
ARTIFACT_EXPORT_ENABLED=true
TASK_SANDBOX_ENABLED=true
TASK_SANDBOX_IMAGE=openmake-task-runtime:latest
TASK_SANDBOX_APPROVAL_POLICY=all
TASK_SANDBOX_NETWORK=none
TASK_SANDBOX_EXTRA_TOOLS=web_search
TASK_SANDBOX_BROWSER_ENABLED=true
TASK_SANDBOX_BROWSER_PERSIST=true
TASK_SANDBOX_BROWSER_NETWORK=bridge
TASK_SANDBOX_WORKSPACE_QUOTA=2147483648
TASK_SANDBOX_WORKSPACE_TTL_MS=259200000

# ── 로컬 실행 브리지 (컴패니언·CLI) ──
LOCAL_EXECUTOR_ENABLED=true
LOCAL_BRIDGE_MAX_DEVICES=6

# ── 검색·문서 ──
SEARCH_SEMANTIC_RERANK_ENABLED=true
SEARCH_SEMANTIC_RERANK_SHADOW=true
SCRAPER_IMPERSONATE_ENABLED=true
SCRAPER_IMPERSONATE_WHITELIST=reddit.com,www.reddit.com,old.reddit.com,oauth.reddit.com,arca.live,www.gartner.com,gartner.com
NAVER_API_DAILY_LIMIT=25000
DEEP_RESEARCH_CITATION_TARGET=0.9
DEEP_RESEARCH_MAX_SCRAPE_PER_LOOP=10
DOC_EXTRACT_PDF_TIMEOUT_MS=120000
PDF_VISION_MAX_PAGES=8
PDF_VISION_TOTAL_IMAGE_CAP=8

# ── 브랜딩 ──
OMK_APP_TITLE=OpenMake LLM
OMK_APP_CATEGORIES=ai-platform

# ── Discord 봇 접근 정책 (봇을 켤 때만 의미 있음) ──
DISCORD_ALLOW_ALL_USERS=true
DISCORD_REQUIRE_MENTION=true
DISCORD_BOT_REQUEST_TIMEOUT_MS=300000
