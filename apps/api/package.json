{
    "name": "openmake-api",
    "version": "1.115.11",
    "description": "OpenMake API Server",
    "main": "dist/server.js",
    "scripts": {
        "build": "node ../../scripts/tsc7.cjs && npm run copy-addons && npm run copy-report-templates && npm run build-info",
        "copy-report-templates": "mkdir -p dist/report-templates && cp -R src/report-templates/. dist/report-templates/",
        "build-info": "node ../../scripts/build-info.js",
        "copy-addons": "rm -rf dist/addon-packs && cp -R addons dist/addon-packs",
        "dev": "ts-node --files src/server.ts",
        "addons:build": "ts-node --files src/addon-host/authoring/build-packs.ts",
        "start": "node dist/server.js",
        "worker:knowledge": "node dist/workers/knowledge-worker.js",
        "dev:worker:knowledge": "ts-node --files src/workers/knowledge-worker.ts",
        "watch": "node ../../scripts/tsc7.cjs --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "eval:routing": "ts-node src/evaluation/run-evaluation.ts",
        "eval:routing:strict": "OMK_EVAL_PASS_THRESHOLD=1.0 ts-node src/evaluation/run-evaluation.ts",
        "eval:response": "ts-node src/evaluation/run-response-evaluation.ts",
        "eval:citation": "ts-node src/addons/deep-research/evaluation/run-citation-evaluation.ts",
        "eval:knowledge": "ts-node src/addons/knowledge-runtime/evaluation/run-knowledge-evaluation.ts",
        "eval:budget": "ts-node src/evaluation/run-budget-evaluation.ts",
        "eval:tools": "ts-node src/evaluation/run-tool-selection-evaluation.ts",
        "eval:trajectory": "ts-node src/evaluation/run-trajectory-evaluation.ts",
        "eval:compaction": "ts-node src/evaluation/run-compaction-evaluation.ts",
        "eval:memory-rank": "ts-node src/evaluation/run-memory-rank-evaluation.ts",
        "eval:ablation": "ts-node src/evaluation/run-prompt-ablation.ts",
        "eval:agent-tasks": "ts-node src/evaluation/run-prompt-ablation.ts --variants baseline --gate",
        "eval:agent-tasks:browser": "ts-node src/evaluation/run-prompt-ablation.ts --variants baseline --browser only",
        "eval:matrix": "ts-node src/evaluation/run-matrix-evaluation.ts",
        "eval:probe": "ts-node src/evaluation/run-model-probe.ts",
        "eval:redteam": "ts-node src/evaluation/redteam/run-redteam-evaluation.ts",
        "eval:packs": "ts-node src/evaluation/run-pack-evaluation.ts",
        "eval:guard-stats": "ts-node src/evaluation/run-guard-stats.ts",
        "replay:request": "ts-node src/scripts/replay-request.ts",
        "eval:all": "npm run eval:routing && npm run eval:response && npm run eval:citation && npm run eval:tools && npm run eval:redteam"
    },
    "dependencies": {
        "@modelcontextprotocol/client": "^2.3.1",
        "@mozilla/readability": "^0.6.0",
        "@openai-oauth/core": "^2.0.0",
        "@opendataloader/pdf": "^2.5.15",
        "@openmake/config": "*",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
        "@opentelemetry/instrumentation-express": "^0.72.0",
        "@opentelemetry/instrumentation-http": "^0.300.0",
        "@opentelemetry/resources": "^3.0.0",
        "@opentelemetry/sdk-node": "^0.300.0",
        "@opentelemetry/sdk-trace": "^3.0.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@types/pg": "^8.23.1",
        "babel-jest": "^30.4.1",
        "bcryptjs": "^3.0.3",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "fflate": "^0.8.3",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "js-yaml": "^5.5.0",
        "jsdom": "^30.1.3",
        "jsonwebtoken": "^9.0.3",
        "kordoc": "^4.24.1",
        "lru-cache": "^11.5.2",
        "multer": "^2.3.0",
        "nodemailer": "^10.1.2",
        "officeparser": "^8.2.0",
        "openai": "^7.43.0",
        "ora": "^9.4.1",
        "pg": "^8.23.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "undici": "^8.12.3",
        "uuid": "^14.0.3",
        "web-push": "^3.6.7",
        "winston": "^3.19.0",
        "ws": "^8.21.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@opentelemetry/context-async-hooks": "^3.0.0",
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/jsdom": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/turndown": "^5.0.6",
        "@types/web-push": "^3.6.4",
        "@types/ws": "^8.18.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
