{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openmake/openmake-marketplace/schema/catalog-index.v1.schema.json",
  "title": "OpenMake catalog index v1",
  "description": "Static catalog index generated by CI from .claude-plugin/marketplace.json. openmake_llm syncs a catalog from this one file (EXTENSION_CATALOG_INDEX_ENABLED + index_url). Hashes: each plugin's sha256 = sha256(canonical JSON of the plugin without sha256); pluginsSha256 = sha256(plugin sha256 values joined by \\n). Canonical JSON = object keys sorted, undefined omitted, no whitespace. Change the format only by bumping schemaVersion — readers skip versions they do not know.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "generatedAt", "repository", "commit", "marketplace", "plugins", "pluginsSha256"],
  "properties": {
    "schema": { "const": "openmake.catalog-index" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "maxLength": 64 },
    "repository": { "type": "string", "maxLength": 200, "description": "owner/repo of the curation repository that produced this index" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "curation repository commit the index was built from" },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 }
      }
    },
    "plugins": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "commit", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "maxLength": 2000 },
          "version": { "type": "string", "maxLength": 64 },
          "category": { "type": "string", "maxLength": 64 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["git-subdir", "url", "relative"] },
              "url": { "type": "string", "maxLength": 500 },
              "path": { "type": "string", "maxLength": 300 }
            }
          },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "pinned commit of the plugin source (relative entries: the curation repository commit)" },
          "installable": { "type": "boolean" },
          "compat": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": "string", "maxLength": 200 },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } }
              ]
            }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "pluginsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
